<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.am31.am31.view.gui.scene.GameController">
   <children>
      <BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-background-color: orange;">
         <top>
            <HBox alignment="CENTER" maxWidth="-Infinity" prefHeight="100.0" spacing="50.0" style="-fx-background-color: rgba(255,243,211,1); -fx-border-color: black;" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="roundLabel" alignment="CENTER" prefWidth="300.0" text="Round 1" textAlignment="CENTER">
                     <font>
                        <Font name="Inknut Antiqua Regular" size="30.0" />
                     </font>
                  </Label>
                  <Separator orientation="VERTICAL" prefHeight="200.0" />
                  <Label fx:id="eraLabel" alignment="CENTER" prefWidth="300.0" text="Era 1">
                     <font>
                        <Font name="Inknut Antiqua Regular" size="30.0" />
                     </font>
                  </Label>
                  <Separator orientation="VERTICAL" prefHeight="200.0" />
                  <Label fx:id="turnLabel" alignment="CENTER" prefWidth="300.0" text="Turno Mario">
                     <font>
                        <Font name="Inknut Antiqua Regular" size="30.0" />
                     </font>
                  </Label>
                  <Separator orientation="VERTICAL" prefHeight="200.0" />
                  <Label fx:id="phaseLabel" alignment="CENTER" prefWidth="300.0" text="Fase Totem">
                     <font>
                        <Font name="Inknut Antiqua Regular" size="30.0" />
                     </font>
                  </Label>
               </children>
               <padding>
                  <Insets left="50.0" right="50.0" />
               </padding>
            </HBox>
         </top>
         <center>
            <HBox maxHeight="-Infinity" prefHeight="560.0" prefWidth="1600.0" BorderPane.alignment="CENTER">
               <VBox alignment="CENTER" prefHeight="560.0" prefWidth="147.0">
                  <children>
                     <ImageView fx:id="deckImage" fitHeight="180.0" fitWidth="127.0" nodeOrientation="INHERIT" pickOnBounds="true" preserveRatio="true" />
                  </children>
                  <padding>
                     <Insets right="20.0" />
                  </padding>
               </VBox>
               <VBox maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="560.0" prefWidth="1223.0" BorderPane.alignment="CENTER">
               <children>
                  <ScrollPane maxHeight="-Infinity" prefHeight="180.0" style="-fx-padding: 0; -fx-background-insets: 0; -fx-border-width: 0;" vbarPolicy="NEVER">
                     <content>
                        <HBox fx:id="upperRowContainer" alignment="CENTER" maxHeight="-Infinity" minWidth="-Infinity" prefHeight="180.0" spacing="10.0" HBox.hgrow="ALWAYS" />
                     </content>
                        <VBox.margin>
                           <Insets />
                        </VBox.margin>
                  </ScrollPane>
                  <HBox fx:id="offerTrackContainer" prefHeight="180.0" />
                  <ScrollPane maxHeight="-Infinity" prefHeight="180.0" style="-fx-padding: 0; -fx-background-insets: 0; -fx-border-width: 0;" vbarPolicy="NEVER">
                     <content>
                        <HBox fx:id="lowerRowContainer" prefHeight="180.0" spacing="10.0" HBox.hgrow="ALWAYS" />
                     </content>
                        <VBox.margin>
                           <Insets />
                        </VBox.margin>
                  </ScrollPane>
               </children>
               </VBox>
               <BorderPane.margin>
                  <Insets bottom="15.0" top="25.0" />
               </BorderPane.margin>
            </HBox>
         </center>
         <right>
            <VBox fx:id="playersContainer" prefWidth="275.0" BorderPane.alignment="CENTER" />
         </right>
         <bottom>
            <HBox prefHeight="380.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox alignment="CENTER" prefHeight="380.0" prefWidth="200.0">
                     <children>
                        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <ImageView fx:id="foodIcon" fitHeight="45.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                              <Label fx:id="myFoodLabel" text="Label">
                                 <HBox.margin>
                                    <Insets left="15.0" />
                                 </HBox.margin>
                                 <font>
                                    <Font name="Inknut Antiqua Regular" size="16.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <ImageView fx:id="PPIcon" fitHeight="45.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                              <Label fx:id="myPPLabel" text="Label">
                                 <HBox.margin>
                                    <Insets left="15.0" />
                                 </HBox.margin>
                                 <font>
                                    <Font name="Inknut Antiqua Regular" size="16.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox prefHeight="380.0">
                     <children>
                        <ScrollPane style="-fx-padding: 0; -fx-background-insets: 0; -fx-border-width: 0;" vbarPolicy="NEVER">
                           <content>
                              <HBox fx:id="myTribeContainer" prefHeight="180.0" spacing="10.0" />
                           </content>
                           <VBox.margin>
                              <Insets bottom="10.0" />
                           </VBox.margin>
                        </ScrollPane>
                        <ScrollPane style="-fx-padding: 0; -fx-background-insets: 0; -fx-border-width: 0;" vbarPolicy="NEVER">
                           <content>
                              <HBox fx:id="myBuildingsContainer" prefHeight="180.0" spacing="10.0" />
                           </content>
                           <VBox.margin>
                              <Insets bottom="10.0" />
                           </VBox.margin>
                        </ScrollPane>
                     </children>
                  </VBox>
               </children>
               <BorderPane.margin>
                  <Insets />
               </BorderPane.margin>
            </HBox>
         </bottom>
         <left>
            <VBox prefWidth="275.0" BorderPane.alignment="CENTER" />
         </left>
      </BorderPane>
      <StackPane fx:id="deckOverlay" prefHeight="150.0" prefWidth="200.0" visible="false">
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <HBox prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Label fx:id="ownerName" text="Label" />
                        <Button mnemonicParsing="false" onAction="#closeTribeViewer" text="X" />
                     </children>
                  </HBox>
                  <ScrollPane prefHeight="200.0" prefWidth="200.0">
                     <content>
                        <HBox fx:id="tribePlayerContainer" prefHeight="100.0" prefWidth="200.0" />
                     </content>
                  </ScrollPane>
                  <ScrollPane prefHeight="200.0" prefWidth="200.0">
                     <content>
                        <HBox fx:id="buildingsPlayerContainer" prefHeight="100.0" prefWidth="200.0" />
                     </content>
                  </ScrollPane>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</StackPane>
