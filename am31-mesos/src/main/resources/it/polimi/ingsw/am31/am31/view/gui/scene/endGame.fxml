<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="stackPane" stylesheets="@../assets/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.am31.am31.view.gui.scene.EndGameController">
    <children>
        <ImageView fx:id="backgroundImage" pickOnBounds="true">
            <image>
                <Image url="@../assets/Background.jpg" />
            </image>
        </ImageView>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="20.0">
         <children>
            <VBox fx:id="rankingBox" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" style="-fx-background-color: rgba(255,243,211,1);;">
               <children>
                  <Label text="Ranking">
                     <font>
                        <Font name="Inknut Antiqua Bold" size="36.0" />
                     </font>
                     <padding>
                        <Insets left="100.0" right="100.0" />
                     </padding>
                  </Label>
               </children>
               <effect>
                  <DropShadow />
               </effect>
            </VBox>
            <Label fx:id="globalPosition" alignment="CENTER" style="-fx-background-color: rgba(255,243,211,1); -fx-border-color: black;" text="Label">
               <font>
                  <Font name="Inknut Antiqua Regular" size="20.0" />
               </font>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </Label>
            <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity">
               <children>
                  <Button fx:id="backButton" mnemonicParsing="false" onAction="#returnToLobby" style="-fx-background-color: rgba(255,243,211,1); -fx-cursor: hand;" text="Back to menu">
                     <font>
                        <Font name="Inknut Antiqua Regular" size="20.0" />
                     </font>
                  </Button>
                  <Button fx:id="globalRanking" layoutX="856.0" layoutY="27.0" mnemonicParsing="false" onAction="#showGlobalRanking" style="-fx-background-color: rgba(255,243,211,1); -fx-cursor: hand;" text="Global ranking">
                     <font>
                        <Font name="Inknut Antiqua Regular" size="20.0" />
                     </font>
                  </Button>
               </children>
               <effect>
                  <DropShadow />
               </effect>
            </HBox>
         </children>
      </VBox>
      <StackPane fx:id="globalRankingOverlay" prefHeight="150.0" prefWidth="200.0" visible="false">
         <children>
            <Region maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onMouseClicked="#closeGlobalRanking" style="-fx-background-color: rgba(0,0,0,0.6); -fx-cursor: hand;" />
            <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" style="-fx-border-color: black;">
               <children>
                  <Label fx:id="tableTitle" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" style="-fx-background-color: rgba(255,243,211,1);" text="GLOBAL RANKING" textAlignment="CENTER">
                     <font>
                        <Font name="Inknut Antiqua Bold" size="36.0" />
                     </font>
                  </Label>
                  <TableView fx:id="rankingTable" maxHeight="-Infinity" maxWidth="-Infinity" style="-fx-background-color: rgba(255,243,211,1);">
                    <columns>
                      <TableColumn fx:id="rankColumn" prefWidth="75.0" text="Position" />
                      <TableColumn fx:id="nicknameColumn" prefWidth="75.0" text="Nickname" />
                        <TableColumn fx:id="gamesColumn" prefWidth="75.0" text="Games played" />
                        <TableColumn fx:id="foodColumn" prefWidth="75.0" text="Total food" />
                        <TableColumn fx:id="PPColumn" prefWidth="75.0" text="Total prestige" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
               <effect>
                  <DropShadow />
               </effect>
            </VBox>
         </children>
      </StackPane>
    </children>
</StackPane>
