<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="stackPane" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.am31.am31.view.gui.scene.LoginController">
    <children>
        <ImageView fx:id="backgroundImage" pickOnBounds="true">
            <image>
                <Image url="@../assets/Background.jpg" />
            </image>
        </ImageView>
        <VBox alignment="TOP_CENTER" prefHeight="300.0" prefWidth="400.0" spacing="15.0">
            <children>
                <ImageView fx:id="logoTitle" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../assets/Title.png" />
                    </image>
                    <VBox.margin>
                        <Insets />
                    </VBox.margin>
                    <effect>
                        <DropShadow height="70.0" radius="34.5" spread="0.3" width="70.0" />
                    </effect>
                </ImageView>
                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <TextField fx:id="nicknameField" promptText="Enter nickname" style="-fx-background-color: rgba(255,243,211,1);">
                            <font>
                                <Font name="Inknut Antiqua Regular" size="20.0" />
                            </font>
                            <effect>
                                <DropShadow />
                            </effect>
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                        </TextField>
                        <Button fx:id="connectButton" mnemonicParsing="false" onAction="#handleConnect" style="-fx-background-color: rgba(255,243,211,1); -fx-cursor: hand;" text="▶">
                            <effect>
                                <DropShadow />
                            </effect>
                            <font>
                                <Font name="Arial Bold" size="50.0" />
                            </font>
                            <padding>
                                <Insets bottom="1.0" left="15.0" right="15.0" top="1.0" />
                            </padding>
                        </Button>
                    </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
                </HBox>
                <Label fx:id="errorLabel" textAlignment="CENTER" textFill="WHITE" visible="false">
                    <font>
                        <Font name="Inknut Antiqua Regular" size="28.0" />
                    </font>
                    <effect>
                        <DropShadow />
                    </effect>
                    <VBox.margin>
                        <Insets top="15.0" />
                    </VBox.margin>
                </Label>
            </children>
        </VBox>
    </children>
</StackPane>
