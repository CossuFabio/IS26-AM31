<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.am31.am31.view.gui.scene.LoginController">
    <children>
        <ImageView fx:id="backgroundImage" fitHeight="1080.0" fitWidth="1920.0" opacity="0.8" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../assets/Background.jpg" />
            </image>
        </ImageView>
        <VBox alignment="CENTER" prefHeight="300.0" prefWidth="400.0" spacing="15.0">
            <children>
                <ImageView fx:id="logoTitle" fitHeight="447.0" fitWidth="993.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../assets/Title.png" />
                    </image>
                    <VBox.margin>
                        <Insets bottom="100.0" />
                    </VBox.margin>
                    <effect>
                        <DropShadow height="70.0" radius="34.5" spread="0.3" width="70.0" />
                    </effect>
                </ImageView>
                <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0" spacing="50.0">
                    <children>
                        <TextField fx:id="nicknameField" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefWidth="500.0" promptText="Enter nickname" style="-fx-background-color: rgba(255,243,211,1);">
                            <font>
                                <Font name="Roboto Italic" size="24.0" />
                            </font>
                            <effect>
                                <DropShadow />
                            </effect>
                        </TextField>
                        <Button fx:id="connectButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleConnect" style="-fx-background-color: rgba(255,243,211,1);" text="▶">
                            <effect>
                                <DropShadow />
                            </effect>
                            <font>
                                <Font name="Arial Bold" size="50.0" />
                            </font>
                            <padding>
                                <Insets bottom="1.0" left="15.0" right="15.0" top="1.0" />
                            </padding>
                        </Button>
                    </children>
                </HBox>
                <Label fx:id="errorLabel" textAlignment="CENTER" textFill="WHITE" visible="false">
                    <font>
                        <Font name="Roboto Bold" size="28.0" />
                    </font>
                    <effect>
                        <DropShadow />
                    </effect>
                    <VBox.margin>
                        <Insets top="15.0" />
                    </VBox.margin>
                </Label>
            </children>
        </VBox>
    </children>
</StackPane>
